# Copy to .env.local and fill. Never commit .env.local.
# This is the complete inventory of what production reads (names only).
# In Vercel, mark every non-NEXT_PUBLIC_ value as Sensitive.

# ---- Firebase Admin (server) — Service accounts → Generate new private key ----
FIREBASE_PROJECT_ID=hapnin-99c6b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hapnin-99c6b.iam.gserviceaccount.com
# Whole private_key value incl. BEGIN/END; keep the \n escapes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional; defaults to <project>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# ---- Firebase Web (client, public) — Project settings → Your apps → Web ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hapnin-99c6b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hapnin-99c6b
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Stripe (Connect Express, destination charges) ----
# Use a RESTRICTED key in production: PaymentIntents, Refunds, Balance, Payouts,
# Events (read), Connect Accounts + Account Links (write).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Email (Brevo transactional API). Unset → emails are logged, not sent. ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=login@hapnin.now
BREVO_SENDER_NAME=Hapnin

# ---- Twilio (optional until A2P 10DLC; sendSMS logs to console until set) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# One of the two:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# ---- Auth / app ----
ADMIN_EMAILS=you@example.com
NEXT_PUBLIC_SITE_URL=https://www.hapnin.now
# Signs ticket QR codes (HMAC). Rotating it invalidates every issued QR.
QR_SECRET=
# Bearer token Vercel Cron sends to /api/cron/*. Generate: openssl rand -base64 32
CRON_SECRET=
# Optional fee-waiver sign-up codes: CODE:days, comma-separated.
LAUNCH_CODES=

# ---- Monitoring (Sentry). All optional; SDK is a no-op without the DSN. ----
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source-map upload:
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Wallet passes (optional; buttons hide when unset) — see docs/wallet-passes.md ----
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_P12_BASE64=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PEM=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=
