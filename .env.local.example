# Copy to .env.local and fill. Never commit .env.local.

# ---- Firebase Admin (server) — from Service accounts → Generate new private key ----
FIREBASE_PROJECT_ID=hapnin-99c6b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@hapnin-99c6b.iam.gserviceaccount.com
# Whole private_key value incl. BEGIN/END; keep the \n escapes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Firebase Web (client, public) — from Project settings → Your apps → Web ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hapnin-99c6b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hapnin-99c6b
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Stripe (Connect Express, destination charges) ----
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Twilio (optional until A2P 10DLC; sendSMS logs to console until set) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Auth / app ----
ADMIN_EMAILS=you@example.com
NEXT_PUBLIC_SITE_URL=https://hapnin.now
