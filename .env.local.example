# Firebase / Firestore — server-only service account credentials.
# From the Firebase console: Project settings → Service accounts →
# "Generate new private key". Copy the three values out of the downloaded JSON.
# These are secret and are only read inside server actions (see lib/firestore.ts).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the whole private_key value, including the BEGIN/END lines. Keep the \n
# escapes as they appear in the JSON — the app converts them back to newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Public site origin, used for canonical + OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=https://hapnin.now
